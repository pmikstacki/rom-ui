{
  "name": "rom-ui",
  "version": "0.1.0-alpha.1",
  "description": "Reusable Svelte controls extracted from ROM Studio",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pmikstacki/rom-ui.git"
  },
  "files": [
    "src",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "docs/design.md",
    "evidence/source.json",
    "dist/headless"
  ],
  "exports": {
    ".": {
      "types": "./src/controls.ts",
      "svelte": "./src/controls.ts",
      "default": "./src/controls.ts"
    },
    "./controls": {
      "types": "./src/controls.ts",
      "svelte": "./src/controls.ts",
      "default": "./src/controls.ts"
    },
    "./styles": "./src/styles.css",
    "./ui": {
      "types": "./dist/headless/ui.d.ts",
      "default": "./dist/headless/ui.js"
    },
    "./ui/components": {
      "types": "./src/ui-components.ts",
      "svelte": "./src/ui-components.ts",
      "default": "./src/ui-components.ts"
    },
    "./ui/helpers/*": {
      "types": "./dist/headless/lib/ui/*.d.ts",
      "default": "./dist/headless/lib/ui/*.js"
    },
    "./ui/commands/*": {
      "types": "./dist/headless/lib/ui/components/*.d.ts",
      "default": "./dist/headless/lib/ui/components/*.js"
    },
    "./primitives/*": {
      "types": "./src/lib/components/ui/*/index.ts",
      "svelte": "./src/lib/components/ui/*/index.ts",
      "default": "./src/lib/components/ui/*/index.ts"
    }
  },
  "peerDependencies": {
    "svelte": "5.57.1"
  },
  "dependencies": {
    "@lucide/svelte": "1.51.0",
    "bits-ui": "2.19.5",
    "cn": "0.3.3",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0",
    "shadcn-svelte": "1.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "@types/node": "22.20.5"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "./scripts/check",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "corepack pnpm run build"
  },
  "packageManager": "pnpm@10.30.0"
}
