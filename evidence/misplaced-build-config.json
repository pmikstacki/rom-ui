  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true, "declaration": true,
    "rootDir": "src", "outDir": "dist/headless"
